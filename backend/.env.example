# --- LLM — "mock" works with zero API keys (default for local dev) ---
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# --- Database — leave blank for SQLite (zero setup), set for Postgres ---
DATABASE_URL=

# --- Vector DB — ChromaDB used locally, Pinecone for production ---
CHROMA_PERSIST_DIR=./chroma_db
PINECONE_API_KEY=
PINECONE_INDEX_NAME=medtriage

# --- Auth ---
JWT_SECRET=change-this-to-random-64-char-string
JWT_EXPIRY_HOURS=24

# --- Session retention ---
SESSION_TTL_HOURS=24

# --- Rate limiting ---
RATE_LIMIT_PER_HOUR=100
MAX_TURNS_PER_SESSION=30

# --- File upload ---
MAX_UPLOAD_MB=5

# --- CORS (comma-separated; add your Vercel URL after first deploy) ---
ALLOWED_ORIGINS=http://localhost:5173

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
